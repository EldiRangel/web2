{
  "name": "login-session-api",
  "version": "1.0.0",
  "description": "API de login con Express Session y PostgreSQL",
  "main": "server/app.js",
  "scripts": {
    "start": "node server/app.js",
    "start:prod": "node server/start.js",
    "dev": "nodemon server/app.js",
    "db:schema": "node database/runSql.js database/schema.sql",
    "db:security": "node database/runSql.js database/security.sql",
    "db:payroll": "node database/runSql.js database/payroll.sql",
    "db:setup": "npm run db:schema && npm run db:security && npm run seed && npm run db:payroll",
    "seed": "node database/seed.js",
    "test": "node tests/runTests.js"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "connect-pg-simple": "^9.0.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.5",
    "express-session": "^1.18.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pdfkit": "^0.21.0",
    "pg": "^8.11.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  }
}
